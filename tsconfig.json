{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext", // Change from nodenext to ESNext
    "moduleResolution": "bundler", // Best for modern web development
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": false,
    "noEmit": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}